# Public URL for the proxy backend.
# Used in install commands shown to users.
# Change this to your domain when deploying.
PUBLIC_BASE_URL=https://packages.webflare.ru

# Upstream registry URLs (change only if using a mirror)
NPM_REGISTRY_URL=https://registry.npmjs.org
NUGET_REGISTRY_URL=https://api.nuget.org
DOCKER_REGISTRY_URL=https://registry-1.docker.io
DOCKER_AUTH_URL=https://auth.docker.io/token
